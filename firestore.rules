rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isGM() {
      return signedIn() && exists(/databases/$(database)/documents/gms/$(request.auth.uid));
    }

    // One-time GM setup marker. Created together with the first GM passcode.
    // Sector map: everyone can look, only the GM can change it.
    match /sector/{id} {
      allow read: if signedIn();
      allow write: if isGM();
    }

    // GM-only private notes (initiative tracker).
    match /gmprivate/{id} {
      allow read, write: if isGM();
    }

    match /config/setup {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['done', 'at']);
      allow update, delete: if false;
    }

    // GM passcodes. The document ID is the passcode. Nobody can read these.
    // A new one can only be created during first-time setup.
    match /gmKeys/{key} {
      allow read: if false;
      allow create: if signedIn()
        && key.matches('^[A-Za-z0-9_-]{6,64}$')
        && !exists(/databases/$(database)/documents/config/setup)
        && existsAfter(/databases/$(database)/documents/config/setup);
      allow update, delete: if false;
    }

    // A browser becomes GM by proving it knows a passcode.
    match /gms/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.key is string
        && request.resource.data.key.matches('^[A-Za-z0-9_-]{6,64}$')
        && existsAfter(/databases/$(database)/documents/gmKeys/$(request.resource.data.key));
      allow update, delete: if false;
    }

    // Homebrew compendium: everyone reads, only the GM writes.
    match /homebrew/{id} {
      allow read: if signedIn();
      allow write: if isGM();
    }

    // Homebrew foci: everyone reads, only the GM writes.
    match /foci/{id} {
      allow read: if signedIn();
      allow write: if isGM();
    }

    // Ships: the GM builds them. Players can see shared ships and change their combat state
    // (hit points, Command Points, crises, stations, fuel and so on), but not the ship's design.
    match /ships/{id} {
      allow read: if isGM() || (signedIn() && resource.data.get('shared', false) == true);
      allow create, delete: if isGM();
      allow update: if isGM() || (signedIn()
        && resource.data.get('shared', false) == true
        && resource.data.get('npc', false) != true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hp', 'cp', 'crises', 'roles', 'tmp', 'fuel', 'ammo', 'sys', 'escape', 'dcUses', 'round', 'ecmUsed', 'trip', 'scanQ', 'mishap', 'updatedAt']));
    }
    // Mechs: the GM builds them. A mech assigned to a character is visible to everyone (like the sheet);
    // that character's player can change its combat state but not its design.
    match /mechs/{id} {
      allow read: if isGM() || (signedIn() && resource.data.get('assigned', false) == true);
      allow create, delete: if isGM();
      allow update: if isGM() || (signedIn()
        && resource.data.get('assigned', false) == true
        && resource.data.get('ownerSheet', '') is string && resource.data.get('ownerSheet', '') != ''
        && request.auth.uid in get(/databases/$(database)/documents/sheets/$(resource.data.ownerSheet)).data.get('owners', [])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hp', 'ammoOut', 'fights', 'penalty', 'cellsUsed', 'style', 'updatedAt']));
    }
    // NPCs: only the GM sees them, unless the GM shares one or makes it a character's companion.
    // A companion's player can change its hit points.
    match /npcs/{id} {
      allow read: if isGM() || (signedIn() && (resource.data.shared == true || resource.data.get('companion', false) == true));
      allow create, delete: if isGM();
      allow update: if isGM() || (signedIn()
        && resource.data.get('companion', false) == true
        && resource.data.get('companionOf', '') is string
        && resource.data.get('companionOf', '') != ''
        && request.auth.uid in get(/databases/$(database)/documents/sheets/$(resource.data.companionOf)).data.get('owners', [])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hp', 'updatedAt']));
    }

    // NPC dice rolls: GM only.
    match /npcrolls/{id} {
      allow read, write: if isGM();
    }

    // Character sheets.
    match /sheets/{id} {
      // Players see every sheet the GM hasn't hidden, plus any sheet they've claimed.
      allow read: if isGM() || (signedIn() && (resource.data.hidden == false || request.auth.uid in resource.data.owners));

      // Players can create a sheet that belongs only to them.
      allow create: if isGM() || (signedIn()
        && request.resource.data.owners == [request.auth.uid]
        && request.resource.data.locked == false
        && request.resource.data.get('npc', false) == false
        && request.resource.data.get('hidden', false) == false);

      allow delete: if isGM()
        || (signedIn() && request.auth.uid in resource.data.owners && resource.data.get('locked', false) != true);

      allow update: if isGM() || (signedIn() && (
        // Owners edit their own unlocked sheet, but not GM-only fields.
        (request.auth.uid in resource.data.owners
          && resource.data.get('locked', false) != true
          && !request.resource.data.diff(resource.data).affectedKeys()
               .hasAny(['locked', 'overrides', 'effects', 'owners', 'npc', 'hidden']))
        ||
        // Anyone can claim an unlocked, non-NPC sheet that nobody has claimed yet.
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['owners'])
          && resource.data.get('locked', false) != true
          && resource.data.get('npc', false) != true
          && resource.data.get('owners', []).size() == 0
          && request.resource.data.owners == [request.auth.uid])
        ||
        // The player who claimed a sheet can release it.
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['owners'])
          && request.auth.uid in resource.data.get('owners', [])
          && request.resource.data.owners.size() == 0)
      ));
    }

    // Shared dice log.
    match /rolls/{id} {
      allow read: if signedIn();
      // Players can only roll for a sheet they claimed (or a plain roll with no character).
      allow create: if signedIn() && request.resource.data.by == request.auth.uid && (
        isGM()
        || (request.resource.data.get('sheet', '') == '' && request.resource.data.get('char', '') == '')
        || (request.resource.data.get('ship', '') is string && request.resource.data.get('ship', '') != ''
            && exists(/databases/$(database)/documents/ships/$(request.resource.data.ship))
            && get(/databases/$(database)/documents/ships/$(request.resource.data.ship)).data.get('shared', false) == true)
        || (request.resource.data.get('sheet', '') is string && request.resource.data.get('sheet', '') != ''
            && exists(/databases/$(database)/documents/sheets/$(request.resource.data.sheet))
            && request.auth.uid in get(/databases/$(database)/documents/sheets/$(request.resource.data.sheet)).data.get('owners', [])));
      allow delete: if isGM();
      allow update: if false;
    }
  }
}
